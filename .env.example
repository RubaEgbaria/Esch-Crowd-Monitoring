# Copy to `.env` (never committed) to override the defaults. Relative paths are
# relative to the repository root.

# Where run inputs (data/runs/<run_id>/) and results (cache/<run_id>/) are kept
# CROWD_DATA_DIR=data
# CROWD_CACHE_DIR=cache

# Google OAuth (Desktop app client) and the token created at sign-in
# CROWD_SECRETS_DIR=secrets
# GOOGLE_CLIENT_SECRETS=secrets/google_client_secret.json
# GOOGLE_TOKEN_FILE=secrets/google_token.json

# Browser origins allowed to call the API (default: any localhost port)
# CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
